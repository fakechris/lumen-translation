{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "caption",
  "description": "Minimal event and IPC capability for the live-caption overlay.",
  "windows": ["caption"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-set-ignore-cursor-events",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*/*" },
        { "url": "http://localhost:*/*" },
        { "url": "http://127.0.0.1:*/*" }
      ]
    }
  ]
}
